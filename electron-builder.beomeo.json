{
    "extends": "./electron-builder.json",
    "appId": "org.playentry.entry.beomeo",
    "productName": "범어중엔트리",
    "artifactName": "Entry-Beomeo-${version}-${arch}-Setup.${ext}",
    "npmRebuild": false,
    "beforePack": "scripts/check-windows-native.js",
    "extraMetadata": {
        "version": "2.1.36-beomeo.9",
        "productName": "Entry Beomeo"
    },
    "win": {
        "executableName": "Entry Beomeo",
        "icon": "build/icon-beomeo.ico",
        "target": [{ "target": "nsis", "arch": ["x64"] }],
        "signAndEditExecutable": true
    },
    "nsis": {
        "installerIcon": "build/icon-beomeo.ico",
        "uninstallerIcon": "build/icon-beomeo.ico",
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": "always",
        "createStartMenuShortcut": true,
        "shortcutName": "범어중엔트리",
        "include": "build/installer-beomeo.nsh"
    },
    "extraResources": [
        { "from": "node_modules/entry-hw/app/modules", "to": "modules" },
        { "from": "node_modules/entry-hw/app/firmwares", "to": "firmwares", "filter": ["!examples/"] },
        { "from": "node_modules/entry-hw/app/drivers", "to": "drivers" },
        { "from": "node_modules/entry-js/weights", "to": "weights" },
        { "from": "build/icon-beomeo.ico", "to": "beomeo-hot-pink.ico" }
    ],
    "directories": {
        "output": "dist/beomeo-windows"
    }
}
